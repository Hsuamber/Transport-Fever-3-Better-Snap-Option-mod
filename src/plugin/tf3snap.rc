// Version resource of tf3snap.dll (see version.h).
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TF3SNAP_VERSION_RC
PRODUCTVERSION TF3SNAP_VERSION_RC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", TF3SNAP_PRODUCT
            VALUE "ProductVersion", TF3SNAP_VERSION
            VALUE "FileVersion", TF3SNAP_VERSION
            VALUE "FileDescription", "Better Snap Option - snapping panel for Transport Fever 3"
            VALUE "InternalName", "tf3snap"
            VALUE "OriginalFilename", "tf3snap.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
