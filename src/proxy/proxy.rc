// Version resource of the vulkan-1.dll proxy (see ../plugin/version.h).  ProductName lets the installer tell our
// proxy apart from another mod's vulkan-1.dll; the real Vulkan loader still answers every Vulkan call.
#include <winver.h>
#include "../plugin/version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TF3SNAP_VERSION_RC
PRODUCTVERSION TF3SNAP_VERSION_RC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", TF3SNAP_PRODUCT
            VALUE "ProductVersion", TF3SNAP_VERSION
            VALUE "FileVersion", TF3SNAP_VERSION
            VALUE "FileDescription", "Better Snap Option loader (forwards Vulkan to the system vulkan-1.dll)"
            VALUE "InternalName", "vulkan-1"
            VALUE "OriginalFilename", "vulkan-1.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
